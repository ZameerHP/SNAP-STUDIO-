# Required: Supabase project Settings > API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key is SERVER ONLY. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy alternatives supported: NEXT_PUBLIC_SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY

# Create this confirmed email/password user in Supabase Authentication > Users.
OWNER_EMAIL=supersnapstudio@gmail.com
SITE_URL=https://YOUR-SITE.vercel.app

# Square: credentials from the studio seller's own application and location.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=https://YOUR-SITE.vercel.app/api/webhooks/square

# Optional client email (verified sending domain required)
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=

# Optional e-signatures
DOCUSEAL_API_KEY=
DOCUSEAL_WEBHOOK_SECRET=
